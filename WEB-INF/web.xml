<?xml version="1.0" encoding="UTF-8"?>

<web-app
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                        http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
    version="4.0">


    <!-- ========================= -->
    <!-- LOGIN SERVLET              -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- ATTENDANCE CALCULATOR      -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>AttendanceServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/AttendanceServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- STUDENT ATTENDANCE         -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>StudentAttendanceServlet</servlet-name>
        <servlet-class>StudentAttendanceServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>StudentAttendanceServlet</servlet-name>
        <url-pattern>/StudentAttendanceServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- STUDENT MARKS              -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>StudentMarksServlet</servlet-name>
        <servlet-class>StudentMarksServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>StudentMarksServlet</servlet-name>
        <url-pattern>/StudentMarksServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- FACULTY STUDENTS           -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>FacultyStudentsServlet</servlet-name>
        <servlet-class>FacultyStudentsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FacultyStudentsServlet</servlet-name>
        <url-pattern>/FacultyStudentsServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- FACULTY SUBJECTS           -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>FacultySubjectsServlet</servlet-name>
        <servlet-class>FacultySubjectsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FacultySubjectsServlet</servlet-name>
        <url-pattern>/FacultySubjectsServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- FACULTY MARK ATTENDANCE    -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>FacultyMarkAttendanceServlet</servlet-name>
        <servlet-class>FacultyMarkAttendanceServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FacultyMarkAttendanceServlet</servlet-name>
        <url-pattern>/FacultyMarkAttendanceServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- FACULTY MARKS              -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>FacultyMarkServlet</servlet-name>
        <servlet-class>FacultyMarkServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FacultyMarkServlet</servlet-name>
        <url-pattern>/FacultyMarkServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- FACULTY STUDENTS REPORT    -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>FacultyStudentsReportServlet</servlet-name>
        <servlet-class>FacultyStudentsReportServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FacultyStudentsReportServlet</servlet-name>
        <url-pattern>/FacultyStudentsReportServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- ADMIN SUBJECTS             -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>AdminSubjectsServlet</servlet-name>
        <servlet-class>AdminSubjectsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminSubjectsServlet</servlet-name>
        <url-pattern>/AdminSubjectsServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- ADMIN STUDENTS             -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>AdminStudentsServlet</servlet-name>
        <servlet-class>AdminStudentsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminStudentsServlet</servlet-name>
        <url-pattern>/AdminStudentsServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- ADMIN FACULTY              -->
    <!-- ========================= -->

    <servlet>
        <servlet-name>AdminFacultyServlet</servlet-name>
        <servlet-class>AdminFacultyServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminFacultyServlet</servlet-name>
        <url-pattern>/AdminFacultyServlet</url-pattern>
    </servlet-mapping>


    <!-- ========================= -->
    <!-- AUTOMATIC ATTENDANCE       -->
    <!-- REMINDER SCHEDULER         -->
    <!-- ========================= -->

    <listener>
        <listener-class>AppSchedulerListener</listener-class>
    </listener>


    <!-- ========================= -->
    <!-- WELCOME PAGE               -->
    <!-- ========================= -->

    <welcome-file-list>
        <welcome-file>home.html</welcome-file>
    </welcome-file-list>

</web-app>